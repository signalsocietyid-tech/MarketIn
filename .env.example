# ---------------------------------------------------------------------------
# MarketIn environment variables. Copy to .env.local and fill in.
# Nothing here is required to run the local demo (embedded database).
# ---------------------------------------------------------------------------

# Postgres connection string. In production use Supabase -> Connect ->
# "Transaction pooler" (port 6543) with your database password.
# Leave empty locally to use the embedded demo database (PGlite in .data/pglite).
DATABASE_URL=

# Keep the embedded database in memory instead of .data/pglite (always in memory on Vercel).
MOCK_DB_PERSIST=true

# Show the non-admin one-click demo logins on a real database (after `npm run db:demo`).
ENABLE_DEMO_LOGIN=false

# Secret used to sign the session cookie. 32+ random characters.
# REQUIRED in production (npm run start / Vercel): sign-in is disabled without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Supabase JS (reserved for Supabase Auth/Storage; not used yet) ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (not implemented yet; see docs/PAYMENTS.md) -------------------
# "mock" (default — records pending upgrade requests, never charges), "midtrans" or "xendit".
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
