# ---------------------------------------------------------------------------
# MarketIn environment variables. Copy to .env.local and fill in.
# Nothing here is required to run the local demo (mock data provider).
# ---------------------------------------------------------------------------

# Data provider: "mock" (default, in-memory + .data/marketin-db.json) or "supabase".
DATA_PROVIDER=mock

# Persist the mock database to .data/marketin-db.json between dev restarts.
# Set to "false" on read-only / serverless hosts.
MOCK_DB_PERSIST=true

# Secret used to sign the session cookie in mock auth mode. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Supabase (required when DATA_PROVIDER=supabase) -----------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (not implemented yet; see docs/PAYMENTS.md) -------------------
# "mock" (default — records pending upgrade requests, never charges), "midtrans" or "xendit".
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
